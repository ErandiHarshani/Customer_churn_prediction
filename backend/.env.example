# Copy to backend/.env and fill in. Paths are relative to backend/.
ML_ARTIFACT_DIR=../mlpart/churn_prediction_project/artifacts
RAW_CSV_PATH=../mlpart/churn_prediction_project/churn_with_sentiment.csv
DATABASE_URL=sqlite:///./churn_dashboard.db
JWT_SECRET=change-me-to-a-long-random-string

# Optional: without a key, predictions still work (review sentiment falls back to
# the training median) and retention messages use the fallback text.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=NotifyDEMO
DRY_RUN=true
